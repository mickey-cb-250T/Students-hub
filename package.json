{
  "name": "students-hub-full-project",
  "version": "1.0.0",
  "description": "Students Hub - full stack peer study platform",
  "private": true,
  "type": "module",
  "scripts": {
    "install:all": "npm --prefix students-hub-backend install && npm --prefix students-hub-frontend install",
    "build": "npm --prefix students-hub-frontend run build",
    "start": "node students-hub-backend/server.js",
    "start:prod": "node students-hub-backend/server.js",
    "dev": "node start-dev.js",
    "dev:backend": "npm --prefix students-hub-backend run dev",
    "dev:frontend": "npm --prefix students-hub-frontend run dev",
    "build:frontend": "npm --prefix students-hub-frontend run build"
  }
}
